# Environment Configuration Template for RetainAI
# Copy this file to .env and provide your actual values

# PostgreSQL Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/retainai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# Google Gemini API Key (Spring AI)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (minimum 256 bits for HS256)
JWT_SECRET=your_long_jwt_secret_key_minimum_256_bits_here

# ML Service URL
ML_SERVICE_URL=http://localhost:8000
